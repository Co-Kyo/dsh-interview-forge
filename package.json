{
  "name": "interview-forge-plugin",
  "version": "0.1.0",
  "description": "InterviewForge 速练：完整可分发的标准 DSH 宿主插件（出题→对话内答题→归因→雷达报告）。host 半边注册工具与服务，client 半边注册速练 UI。本地安装，随 dsh 启动加载、重启不丢。",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs"
  }
}
