{
  "name": "dsh-interview-forge",
  "version": "0.3.2",
  "description": "InterviewForge 速练：标准 DSH 宿主插件 bundle（出题→对话内答题→归因→雷达报告）。host 半区注册 forge_* 工具与 ForgeGateway Remote 服务，client 半区注册 ⚡ 速练浮层 UI。随 dsh 启动加载、重启不丢。",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
